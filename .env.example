# Environment Configuration for TaskMesh

# Environment: development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmesh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Database URL (Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/taskmesh

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# API Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Worker & Dispatcher Settings
DEFAULT_JOB_LEASE_TIMEOUT_SECONDS=60
DISPATCHER_POLL_INTERVAL_SECONDS=1
WORKER_CONCURRENCY=4

# Google Gemini API (Phase 2 - AI Diagnostics)
# GEMINI_API_KEY is optional. If omitted, core task execution operates at 100% capacity.
GEMINI_API_KEY=
# Configurable model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
